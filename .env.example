# Reown AppKit project id — https://cloud.reown.com . Optional: without it the signing page
# falls back to the injected (browser extension) connector only.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Robinhood Chain RPC. Defaults to the value in lib/chain.ts when unset.
NEXT_PUBLIC_RH_RPC_URL=

# Public origin. Used for absolute OG image URLs, robots.txt and the sitemap — set this to the
# real origin in production, or share links will point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
